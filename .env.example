# =============================================================================
# Agency-26 Hackathon — per-team app deployment config
# Copy this to `.env` (gitignored) and fill in the values your organizer gave you.
# Used by deploy-app.ps1 to build + deploy your Container Apps.
# =============================================================================

# --- Azure platform (provided by organizer in the event-day info pack) ------
# Replace each <PLACEHOLDER> with the value from your organizer info pack.
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_PREFIX=<env-prefix>
PLATFORM_RG=<platform-resource-group>
TEAM_RG=<your-team-resource-group>
ACR_NAME=<acr-name>
ACR_LOGIN_SERVER=<acr-name>.azurecr.io
CONTAINER_APPS_ENV=<container-apps-environment-name>
KEY_VAULT_NAME=<key-vault-name>
APIM_GATEWAY_URL=https://<apim-name>.azure-api.net

# --- Per-team APIM subscription key (organizer hands one to each team) -------
APIM_SUBSCRIPTION_KEY=

# --- Render Postgres (read-only replica, paste your connection string) ------
# Format: postgresql://user:pass@host/dbname
DB_CONNECTION_STRING=

# --- Optional: extra LLM providers ------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- App settings (defaults are fine) ---------------------------------------
DASHBOARD_APP_NAME=ca-<env-prefix>-dashboard
DOSSIER_APP_NAME=ca-<env-prefix>-dossier
APP_IMAGE_TAG=latest
